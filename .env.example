# KrishiGen AI Root Configuration Reference
# Duplicate this file to backend/.env to configure the backend

# Optional: Google Gemini API Key for live AI responses (Chat & Vision)
# Get a free key at: https://aistudio.google.com/
# Leave empty to automatically run in graceful Demo Mode!
GEMINI_API_KEY=

# Model name to use (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Vision Model (defaults to gemini-1.5-flash)
GEMINI_VISION_MODEL=gemini-1.5-flash

# Server settings
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

